{
  "name": "flyrank-capstone-metering-billing",
  "version": "1.0.0",
  "description": "Usage Metering & Billing Engine with idempotent tracking, quota enforcement, integer money math, Stripe integration, user auth, and multi-provider dashboard",
  "main": "dist/server.js",
  "scripts": {
    "build:client": "npm run build --prefix client",
    "build:server": "tsc",
    "build": "node scripts/prepare-db.js && prisma generate && npm run build --prefix client && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:prepare": "node scripts/prepare-db.js",
    "db:push": "node scripts/prepare-db.js && prisma db push",
    "db:generate": "node scripts/prepare-db.js && prisma generate",
    "postinstall": "node scripts/prepare-db.js && prisma generate",
    "seed": "ts-node src/scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.0",
    "stripe": "^14.19.0",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
